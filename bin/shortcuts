#!/bin/sh
# The Shortcuts & Elegant Methods course: shortcuts parse | list | gen run|status|verify | publish
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
case "$1" in
  gen) shift; exec "$PY" "$ROOT/foundry/shortcuts_gen.py" "$@" ;;
  publish) exec "$PY" "$ROOT/build/publish.py" ;;
  *) exec "$PY" "$ROOT/build/shortcuts.py" "$@" ;;
esac
