#!/bin/bash
# STEM Tutor: start the terminal app (or `tutor doctor` to check the setup, `tutor --setup` to reinstall).
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export PYTHONPATH="$ROOT/app:$ROOT/plugin/stem-tutor/skills/tutor/scripts${PYTHONPATH:+:$PYTHONPATH}"
if [ ! -f "$ROOT/.venv/.ready" ] || [ "$1" = "--setup" ]; then  # .ready: the last setup finished
  echo "Setting up STEM Tutor (one time)…"
  if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    echo "STEM Tutor needs Python 3.10 or newer; python3 is $(python3 --version 2>&1)." >&2
    echo "Install a newer Python (python.org or Homebrew), then run: tutor --setup" >&2
    exit 1
  fi
  rm -f "$ROOT/.venv/.ready"
  if ! { python3 -m venv "$ROOT/.venv" && "$ROOT/.venv/bin/python" -m pip install -q -r "$ROOT/app/requirements.txt"; }; then
    rm -rf "$ROOT/.venv"  # a half-made venv would pass for a working one
    echo "Setup failed (see above). Check the internet connection, then run: tutor --setup" >&2
    exit 1
  fi
  touch "$ROOT/.venv/.ready"
  [ "$1" = "--setup" ] && shift
fi
exec "$ROOT/.venv/bin/python" -m tutor_app "$@"
