#!/bin/bash
# STEM Tutor: start the terminal app (or `tutor doctor` to check the setup, `tutor --setup` to reinstall).
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export PYTHONPATH="$ROOT/app:$ROOT/plugin/stem-tutor/skills/tutor/scripts${PYTHONPATH:+:$PYTHONPATH}"
if [ ! -x "$ROOT/.venv/bin/python" ] || [ "$1" = "--setup" ]; then
  echo "Setting up STEM Tutor (one time)…"
  python3 -m venv "$ROOT/.venv" && "$ROOT/.venv/bin/python" -m pip install -q -r "$ROOT/app/requirements.txt" || exit 1
  [ "$1" = "--setup" ] && shift
fi
exec "$ROOT/.venv/bin/python" -m tutor_app "$@"
