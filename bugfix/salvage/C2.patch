+    note.write_text(NOTE, encoding="utf-8")
+    _mount_that_refuses_replacing(monkeypatch, note)
+    monkeypatch.setattr(Path, "write_bytes", lambda self, data: (_ for _ in ()).throw(OSError("still full")))
+    new = NOTE.replace("old status", "new status")
+    with pytest.raises(OSError):
+        store.write_text(note, new)
+    monkeypatch.undo()
+    (tmp,) = tmp_path.glob(".scratch.md.*.tmp")
+    assert tmp.read_text(encoding="utf-8") == new
+
+
+def test_a_write_in_place_that_works_still_replaces_the_note_and_cleans_up(tmp_path, monkeypatch):  # B-142
