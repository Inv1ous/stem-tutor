+# ---------------- B-142 ----------------
+NOTE = ("# Scratch note\n\n<!-- stem-tutor:status -->\nold status\n<!-- /stem-tutor:status -->\n\n"
+        "## My working\nvelocity = displacement / time\n")
+
+
+def _mount_that_refuses_replacing(monkeypatch, note, keep=20):
+    """os.replace refuses (the documented fallback); the write in place then stops after `keep` characters."""
+    def refuse(src, dst):
+        raise OSError("this mount refuses replacing a file")
+
+    real = Path.write_text
+
+    def cut(self, text, *a, **k):
+        if self == note:
+            real(self, text[:keep], *a, **k)
+            raise OSError("disk full")
+        return real(self, text, *a, **k)
+
+    monkeypatch.setattr(store.os, "replace", refuse)
+    monkeypatch.setattr(Path, "write_text", cut)
+
+
+def test_a_cut_short_write_in_place_leaves_the_old_note_not_a_torn_one(tmp_path, monkeypatch):  # B-142
+    note = tmp_path / "My Notes" / "scratch.md"
+    note.parent.mkdir()
+    note.write_text(NOTE, encoding="utf-8")
+    _mount_that_refuses_replacing(monkeypatch, note)
+    with pytest.raises(OSError):
+        store.write_text(note, NOTE.replace("old status", "new status"))
+    monkeypatch.undo()
+    assert note.read_text(encoding="utf-8") == NOTE  # the learner's paragraph is still there
+    assert not list(note.parent.glob(".*.tmp"))
+
+
+def test_if_even_the_old_note_cannot_be_put_back_the_temp_copy_keeps_the_new_text(tmp_path, monkeypatch):  # B-142
