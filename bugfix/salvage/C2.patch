@@ -0,0 +1,359 @@
+"""Bug-watch batch C2: the learning model, the stored log and the notes the engine writes.
+
+B-067 a part-marked answer is not a successful day · B-091 a session past midnight counts the day of its answers ·
+B-070 an older event synced in a conflict copy reaches the state · B-142 a cut-short in-place write keeps the old file ·
+B-077 re-teaching keeps your earlier words in My Notes · B-092 a refresh never overwrites a save made while it worked.
+"""
+import json
+import random
+from datetime import datetime, timedelta
+from pathlib import Path
+
+import pytest
+
+from fixtures import make_vault
+from tutorlib import grade, model, profile, session, store, views
+
+T0 = datetime.fromisoformat("2026-09-29T17:00:00+08:00")
+KC = "9702-2.1.1"
+SUB = "9702-2.1"
+
+
+@pytest.fixture
+def tutor(tmp_path):
+    return session.Tutor(store.Vault(make_vault(tmp_path)), rng=random.Random(0), now=lambda: T0)
+
+
+def restart(t):
+    return session.Tutor(t.vault, rng=random.Random(0), now=lambda: T0)
+
+
+def answer(ts=T0, correct=True, score=1.0, kc=KC, item=None, session_id=None, **extra):
+    return {"type": "answer", "ts": ts.isoformat(), "kcs": [kc], "subject": "phys", "difficulty": 3, "conf": 3,
+            "hinted": False, "item": item or f"i{ts.timestamp()}", "marks": 4, "seconds": 30, "pos": 0,
+            "grade": {"correct": correct, "score": score, "error": None, "misconception": None},
+            **({"session": session_id} if session_id else {}), **extra}
+
+
+def fold(events):
+    s = model.new_state()
+    for e in events:
+        model.apply(s, e)
+    return s
+
+
+# ---------------- B-067 ----------------
+def test_three_of_four_self_marked_points_is_not_a_successful_day():  # B-067
+    item = {"kind": "structured", "scheme": [{"mark": f"M{i}", "point": "p"} for i in range(1, 5)]}
+    partial = grade.grade_item(item, {"kind": "points", "value": [1, 2, 3]})
+    assert partial["correct"] is False and partial["score"] == 0.75  # the session reports this answer as wrong
+    s = fold([answer(ts=T0 + timedelta(days=d), item=f"p{d}", correct=False, score=0.75) for d in range(20)])
+    k = s["kcs"][KC]
+    assert k["succ_days"] == [] and k["last_rating"] == "again"
+    assert k["theta"] >= model.MASTERY_THETA  # the marks it did earn still raise ability
+    assert not model.is_mastered(k)  # but twenty days of near-misses are not mastery
+
+
+def test_full_marks_on_two_days_still_masters_the_idea():  # B-067, the other side of it
+    item = {"kind": "structured", "scheme": [{"mark": f"M{i}", "point": "p"} for i in range(1, 5)]}
+    full = grade.grade_item(item, {"kind": "points", "value": [1, 2, 3, 4]})
+    assert full["correct"] is True and full["score"] == 1.0
+    s = fold([answer(ts=T0 + timedelta(days=d), item=f"f{d}") for d in range(6)])
+    assert len(s["kcs"][KC]["succ_days"]) == 6 and model.is_mastered(s["kcs"][KC])
+
+
+def test_a_hinted_part_marked_answer_is_not_rated_as_a_right_answer_with_help():  # B-067
+    s = fold([answer(correct=False, score=0.75, hinted=True)])
+    assert s["kcs"][KC]["last_rating"] == "again" and s["kcs"][KC]["succ_days"] == []
+
+
+# ---------------- B-091 ----------------
+def end_of(session_id, ts, answered=1, abandoned=False):
+    return {"type": "session_end", "ts": ts.isoformat(), "session": session_id, "answered": answered,
+            "abandoned": abandoned}
+
+
+def start_of(session_id, ts):
+    return {"type": "session_start", "ts": ts.isoformat(), "session": session_id}
