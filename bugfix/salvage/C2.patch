+# ---------------- B-092 ----------------
+def an_editor_saves_before_the_tutor_writes(monkeypatch, path, times):
+    """An Obsidian save that lands after the tutor read the note and before it writes it back, `times` times."""
+    real, saved = store.write_text, []
+
+    def racing(p, text, *a, **k):
+        if Path(p) == path and len(saved) < times:
+            saved.append(f"## My latest working {len(saved) + 1}\nVelocity is displacement divided by time ({len(saved) + 1}).")
+            path.write_text(path.read_text(encoding="utf-8") + "\n" + saved[-1] + "\n", encoding="utf-8")
+        return real(p, text, *a, **k)
+
+    monkeypatch.setattr(store, "write_text", racing)
+    monkeypatch.setattr(views, "write_text", racing)
+    return saved
+
+
+def test_a_save_made_while_the_notes_are_refreshed_is_not_erased(tutor, monkeypatch):  # B-092
+    teach(tutor, "my words")
+    path = tutor.vault.root / views.notes_rel(tutor.packs, SUB)
+    saved = an_editor_saves_before_the_tutor_writes(monkeypatch, path, 1)
+    views.notes_update(tutor.vault.root, tutor.packs, tutor.state, SUB, current=KC)  # a map refresh
+    text = path.read_text(encoding="utf-8")
+    assert saved and saved[0] in text and "my words" in text
+    assert ":::now" in text  # and the refresh itself still happened
+
+
+def test_a_save_made_while_a_taught_idea_is_added_is_not_erased(tutor, monkeypatch):  # B-092
