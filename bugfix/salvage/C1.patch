@@ -0,0 +1,413 @@
+"""Bug-watch batch C1: the session engine and its reports (B-063 B-046 B-066 B-079 B-108 B-068 B-132 B-139 B-133
+B-084 B-105 B-103 B-106 B-090). Each test is named for the finding it pins."""
+import json
+import random
+import sqlite3
+import zipfile
+from datetime import datetime
+
+import pytest
+
+from fixtures import make_vault
+from tutorlib import anki, insights, report, session, store, views
+
+T0 = datetime.fromisoformat("2026-09-29T17:00:00+08:00")  # Almanac week 5
+
+
+class Clock:
+    def __init__(self, t):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.fixture
+def tutor(tmp_path):
+    clock = Clock(T0)
+    t = session.Tutor(store.Vault(make_vault(tmp_path)), rng=random.Random(0), now=clock)
+    t.clock = clock
+    return t
+
+
+def _restart(tutor):
+    t = session.Tutor(tutor.vault, rng=random.Random(0), now=tutor.clock)
+    t.clock = tutor.clock
+    return t
+
+
+def _stop(*a, **kw):
+    raise RuntimeError("the app stopped here")
+
+
+def _mcq(tutor, block="practice"):
+    """Put the first multiple-choice question of the fixture pack on screen; returns its number."""
+    item = next(i for i in tutor.packs.items_for("9702-2.1.1") if i["kind"] == "mcq")
+    return tutor._present(item, block=block, phase=None)["n"]
+
+
+def _wrong(tutor, n):
+    inst = tutor.session["presented"][str(n)]["inst"]
+    return f"{n}{next(k for k in inst['options'] if k != inst['answer'])}3"
+
+
+def _right(tutor, n):
+    inst = tutor.session["presented"][str(n)]["inst"]
+    if inst["kind"] == "mcq":
+        return f"{n}{inst['answer']}3"
+    return f"{n} = {inst['answer']['value']:.3g} {inst['answer'].get('unit', '')} ~3"
+
+
+def _planner(tutor, tmp_path):
+    """Point the tutor at a planner file on 'this machine', so the Almanac sync file is written."""
+    planner = tmp_path / "A-Levels.html"
+    planner.write_text("<html></html>")
+    tutor.packs.plan["source_path"] = str(planner)
+    return tmp_path / "A-Levels.tutor.js"
+
+
+def _synced(path):
+    return json.loads(path.read_text()[len("window.TUTOR_SYNC = "):].rstrip().rstrip(";"))
+
+
+# ---------- B-063: a stop during a re-mark ----------
+def test_B063_a_stop_between_the_re_mark_and_the_rebuild_does_not_leave_the_wrong_grade_trusted(tutor, monkeypatch):
+    item = next(i for i in tutor.packs.items_for("9702-2.1.4") if i["id"] == "9702-2.1-i03")  # 4.00 m s-2
+    tutor.start("long", minutes=20, focus=["9702-2.1.4"])
+    n = tutor._present(item, block="practice", phase=None)["n"]
+    fb = tutor.answer(f"{n} = 4.0 metres per second squared ~3")["results"][0]
+    assert not fb["correct"] and not tutor.state["kcs"]["9702-2.1.4"]["succ_days"]
+    monkeypatch.setattr(tutor, "rebuild", _stop)  # the re-mark is in the log; the state is not rebuilt from it
+    with pytest.raises(RuntimeError):
+        tutor.regrade(fb["event"], "the same acceleration, with the unit in words")
+    t = _restart(tutor)
