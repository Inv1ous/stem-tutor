+# ---------- B-079: a stop while a session is ending ----------
+def test_B079_a_session_whose_end_reached_the_log_is_not_reopened_by_a_restart(tutor, monkeypatch):
+    tutor.start("test", minutes=40, focus=["9702-2.1"])
+    n = _mcq(tutor)
+    tutor.answer(_right(tutor, n))
+    log = tutor.log
+
+    def log_then_stop(event):
+        out = log(event)
+        if event["type"] == "session_end":
+            _stop()  # the end is in the log and the session saved as it was: the app stops before closing it
+        return out
+
+    monkeypatch.setattr(tutor, "log", log_then_stop)
+    with pytest.raises(RuntimeError):
+        tutor.end()
+    assert tutor.session_path.read_text() != "null"
+    t = _restart(tutor)
+    assert t.session is None and t.next()["activity"] == "no_session"
+    assert t.session_path.read_text().strip() == "null"  # closed on disk too, so the next start finds nothing to resume
+    t.end()  # ending again records nothing more
+    assert len([e for e in t.vault.events() if e["type"] == "session_end"]) == 1
+    assert _restart(t).session is None
+
