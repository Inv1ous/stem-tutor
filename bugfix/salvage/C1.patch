+# ---------- B-090: two flashcards that share an id ----------
+def _notes(path):
+    with zipfile.ZipFile(path) as z:
+        z.extract("collection.anki2", path.parent / "x")
+    con = sqlite3.connect(path.parent / "x" / "collection.anki2")
+    rows = con.execute("select guid, flds from notes").fetchall()
+    con.close()
+    return rows
+
+
