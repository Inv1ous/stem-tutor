+def _noted(log: views.LessonLog, n: int) -> bool:
+    """Is question n's verdict already in the lesson record? (Its title is "Qn — correct ✓", "Qn — I don't know"…)"""
+    try:
+        text = (log.root / log.rel).read_text(encoding="utf-8")
+    except (OSError, ValueError):
+        return False
+    return re.search(rf"^> \[![a-z]+\] Q{n} — ", text, re.M) is not None
+
+
+def _spoken_stem(inst: dict) -> str | None:
+    """The words an author wrote for reading a question aloud where its stem cannot be spoken (a diagram or schematic),
+    when they are safe to give before the answer: not blank, not a template with its numbers still to draw, and not
+    spelling out the right answer. `speech` may hold {"stem": …, "explanation": …}: only the stem part is the question."""
+    speech = inst.get("speech")
+    text = speech.get("stem") if isinstance(speech, dict) else speech
+    if not isinstance(text, str) or not text.strip() or "[[" in text:
+        return None
+    try:
+        key = _display_answer(inst)
+    except (KeyError, TypeError, ValueError):  # an answer that cannot be shown cannot be checked: say nothing
+        return None
+    plain = lambda t: " ".join(re.sub(r"[*_`$\\]", "", t).lower().split())  # noqa: E731
+    key = plain(key.partition(": ")[2] if inst["kind"] == "mcq" else key)  # a choice: its text, not its letter
+    return None if len(key) > 6 and key in plain(text) else text.strip()
+
+
 def _teach_text(act: dict) -> str:
     return act.get("outline", "") + "".join(f"\n- Trap: {m}" for m in act.get("misconceptions", []))
 
