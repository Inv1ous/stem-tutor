+def held_note_paths(hold: dict, packs: Path, notes: Path) -> set[str]:
+    """The notes (relative to the notes folder) of the held subtopics, which stay out of the vault. A pack file names its
+    note; with no pack file yet (an unfinished build) the note is found by its chapter number inside the subject's folder,
+    "Subjects/9702 Physics/…/11.2 Fundamental particles.md" for 9702-11.2 or "Subjects/Maths/M1 …/5 …md" for M1-5, so an
+    unreviewed note never goes out just because its pack is missing (B-124)."""
+    held = set()
+    for sub in hold:
+        spec, _, chapter = sub.partition("-")
+        pack = next(iter(packs.glob(f"*/{sub}.json")), None)
+        if pack is not None:
+            held.add(json.loads(pack.read_text())["note"])
+            continue
+        for f in notes.rglob("*.md"):
+            rel = f.relative_to(notes)
+            if f.name.startswith(chapter + " ") and any(part.startswith(spec + " ") for part in rel.parts[:-1]):
+                held.add(str(rel))
+    return held
+
+
+def asset_refs(packs: Path, notes: Path, hold: dict, held_notes: set[str]) -> dict[str, str]:
+    """Every picture a published pack or note points at, as {Assets/…: where it is used}."""
+    refs: dict[str, str] = {}
+    for pk in sorted(packs.glob("*/*.json")):
+        if pk.stem in hold:
+            continue
+        pack = json.loads(pk.read_text())
+        for it in pack.get("items", []):
+            if it.get("image"):
+                refs.setdefault(it["image"], f"{it['id']} in {pk.name}")
+        for d in pack.get("diagrams", []):
+            if d.get("file"):
+                refs.setdefault(d["file"], f"a diagram in {pk.name}")
+    for f in sorted(notes.rglob("*.md")):
+        if str(f.relative_to(notes)) not in held_notes:
+            for m in re.finditer(r"!\[\[([^\]|#]+)", f.read_text(encoding="utf-8")):
+                if m.group(1).strip().startswith("Assets/"):
+                    refs.setdefault(m.group(1).strip(), f"the note {f.name}")
+    return refs
+
+
+def missing_assets(refs: dict[str, str], vault: Path) -> list[str]:
+    """The pictures that are neither in the build's Assets folders nor already in the vault."""
+    out = []
+    for ref, where in refs.items():
+        inside = ref.split("/", 1)[1] if "/" in ref else ref
+        if not any((BUILD / d / inside).is_file() for d in ("Assets", "assets")) and not (vault / ref).is_file():
+            out.append(f"{ref} ({where})")
+    return out
+
+
+def _move(staged: Path, dest: Path) -> None:
+    """Put a staged file in its place: a rename, or a copy where the folder refuses a rename (as `store.write_text` does)."""
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        os.replace(staged, dest)
+    except OSError:
+        shutil.copy2(staged, dest)
+        staged.unlink()
+
