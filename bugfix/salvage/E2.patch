+class _Table(TableElement):
+    """A Markdown table that keeps every value whole. Rich fits a table that is too wide for the card by wrapping its
+    cells, and a value with a thousands space ("1 451") comes out as "1" above "451". Here a column never wraps; a table
+    too wide for the card is cut into pieces, as many columns across as fit, each with its own headings."""
+
+    def table(self, heads: list, rows: list, columns: range, wrap: bool = False) -> Table:
+        table = Table(box=box.SIMPLE, pad_edge=False, style="markdown.table.border", show_edge=True,
+                      collapse_padding=True)
+        for i in columns:
+            head = heads[i].copy()
+            head.stylize("markdown.table.header")
+            table.add_column(head, no_wrap=not wrap)
+        for row in rows:
+            table.add_row(*[row[i] for i in columns])
+        return table
+
+    def __rich_console__(self, console, options):
+        heads = [c.content for c in self.header.row.cells] if self.header and self.header.row else []
+        rows = [[c.content for c in r.cells] + [Text()] * (len(heads) - len(r.cells))
+                for r in (self.body.rows if self.body else [])]
+        room = options.max_width
+
+        def width(columns: range) -> int:  # as wide as it would be on one line, whatever the card allows
+            return Measurement.get(console, options.update(max_width=10_000), self.table(heads, rows, columns)).maximum
+
+        pieces, start = [], 0
+        while start < len(heads):
+            end = start + 1
+            while end < len(heads) and width(range(start, end + 1)) <= room:
+                end += 1
+            pieces.append(range(start, end))
+            start = end
+        for columns in pieces:
+            yield self.table(heads, rows, columns, wrap=width(columns) > room)  # one column wider than the card must wrap
+
+
+class _Markdown(Markdown):
+    elements = {**Markdown.elements, "table_open": _Table}
+
+
