+"""Bug-watch fixes in the widgets: answer panels, cards, the app shell, Challenge, the Shortcuts course screens, the Mac
+helpers. One test (or a few) for each finding, named for it."""
+import asyncio
+import json
+import time
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from textual.widgets import Button, Input, OptionList
+
+from test_qol import _menu, _session, run
+from test_tui import app_for
+from tutor_app import cards, look
+from tutor_app.panels import ChoicePanel, Composer, Confidence, ContinuePanel, ReflectPanel, TextPanel, TickPanel, ValuePanel
+
+
+def answers(app):
+    return [e for e in app.tutor.vault.events() if e["type"] == "answer"]
+
+
+def panel_of(scr):
+    return next(iter(scr.query("#panel > *")), None)
+
+
+# ---------------------------------------------------------------- B-135
+def test_b135_a_held_enter_does_not_answer_the_next_question(tmp_path, monkeypatch):
+    """⏎ held down from "Next" repeats into the question Next brought up: it must not pick option A, and then a
+    confidence, for a question nobody has read."""
+    app, v = app_for(tmp_path, monkeypatch)
+
+    async def steps(pilot):
+        scr = await _session(app, pilot)
+        assert isinstance(panel_of(scr), ChoicePanel)
+        await pilot.press("a", "1")  # Q1, answered on purpose
+        await pilot.pause(0.3)
+        for _ in range(4):  # past the "why did you miss it?" panel, if A was wrong, to Next
+            if isinstance(panel_of(scr), ReflectPanel):
+                await pilot.press("escape")
+                await pilot.pause(0.2)
+        assert isinstance(panel_of(scr), ContinuePanel) and len(answers(app)) == 1
+        await pilot.press("enter", "enter", "enter", "enter")  # a key held down: Next, then the repeats
+        await pilot.pause(0.5)
+        q2 = panel_of(scr)
+        assert isinstance(q2, ChoicePanel) and q2.choice is None  # Q2 is up, and unanswered
+        assert len(answers(app)) == 1
+        assert not q2.query(Confidence)  # no confidence step either
+        await pilot.press("down", "enter")  # a deliberate pick still works: move to A, choose it
+        await pilot.pause(0.3)
+        assert q2.choice == "A" and q2.query(Confidence)
+        await pilot.press("enter", "enter")  # and the confidence list asks for a move or a number too
+        await pilot.pause(0.3)
+        assert len(answers(app)) == 1
+        await pilot.press("3")
+        await pilot.pause(0.3)
+        assert len(answers(app)) == 2
+    run(app, (100, 30), steps)
+
+
+def test_b135_a_letter_or_a_number_still_answers_at_once(tmp_path, monkeypatch):
+    app, v = app_for(tmp_path, monkeypatch)
+
+    async def steps(pilot):
+        scr = await _session(app, pilot)
+        choices = scr.query_one("#choices", OptionList)
+        assert choices.highlighted is None  # nothing lit for a ⏎ to take
+        await pilot.press("b")
+        await pilot.pause(0.2)
+        conf = scr.query_one(Confidence)
+        assert conf.highlighted is None
+        await pilot.press("4")
+        await pilot.pause(0.3)
+        assert [a["response"] for a in answers(app)] == ["B"] and answers(app)[0]["conf"] == 4
+    run(app, (100, 30), steps)
