+def _states(text: str, targets: list[float], unit: str, tol: float, true: float | None = None, allowed=None,
+            stated: bool = False) -> bool:
+    """Whether `text` writes any of the `targets` as a number: within `tol` of one, in the answer's `unit` or in
+    another unit of the same kind (0.4 kN for 400 N), or, given the `true` value, rounded the way the marking accepts.
+    With `stated`, only a number the reply asserts counts ("it is 1", "= 1", "1 is the answer", or the reply is just
+    1): a small number is also all over an ordinary hint."""
