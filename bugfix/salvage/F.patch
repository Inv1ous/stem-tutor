+"""Bug-watch batch F, app side: the read-aloud cache (B-127) and the words the voice is given (tts.spoken).
+Hermetic like test_tts.py: a fake engine and a fake player; nothing is installed, downloaded or played."""
+import os
+import threading
+import time
+import wave
+from pathlib import Path
+
+import pytest
+
+from tutor_app import config, tts
+
+
+class FakeEngine:
+    def __init__(self):
+        self.calls = []
+
+    def create(self, text, voice, speed, lang):
+        self.calls.append(text)
+        return [0.5, -0.5, 0.0] * 80, 24000
+
+
+class FakePlayer:
+    def __init__(self):
+        self.played, self.volume = [], None
+
+    playing = False
+
+    def play(self, path, volume=None):
+        self.played.append(Path(path))
+        return True
+
+    def stop(self):
+        pass
+
+
+@pytest.fixture(autouse=True)
+def hermetic(tmp_path, monkeypatch):
+    monkeypatch.setenv("STEM_TUTOR_TTS_DIR", str(tmp_path / "tts-models"))
+    monkeypatch.setattr(tts, "installed", lambda: False)
+    tts.set_engine(None)
+    yield
+    tts.set_engine(None)
+
+
+def speaker(tmp_path, keep=None):
+    s = config.Settings(tts_enabled=True, tts_auto=True)
+    return tts.Speaker(tmp_path / "vault", lambda: s, player=FakePlayer()), s
+
+
+def nframes(path: Path) -> int:
+    with wave.open(str(path)) as w:
+        return w.getnframes()
+
+
+# ---------------- B-127: pruning must not delete a part of the reading being prepared ----------------
+def test_a_cached_part_survives_the_pruning_that_a_new_part_triggers(tmp_path, monkeypatch):
+    monkeypatch.setattr(tts.Speaker, "LIVE_KEEP", 6)
+    tts.set_engine(FakeEngine())
+    sp, s = speaker(tmp_path)
+    # the cache is full, and the verdict "Correct." (reused from an earlier answer) is the oldest line in it
+    verdict = tts.synthesize(tts.spoken("Correct."), sp.live_dir / f"{tts.key_for(tts.spoken('Correct.'), s.tts_voice, s.tts_speed)}.wav",
+                             s.tts_voice, s.tts_speed)
+    old = time.time() - 10_000
+    os.utime(verdict, (old, old))
+    for i in range(sp.LIVE_KEEP - 1):
+        filler = sp.live_dir / f"{i:040x}.wav"
+        filler.write_bytes(b"RIFF")
+        os.utime(filler, (old + 100 + i, old + 100 + i))
+    assert len(list(sp.live_dir.glob("*.wav"))) == sp.LIVE_KEEP
+
+    joined = sp._audio(["Correct.", "A newly requested explanation."], None)  # used to raise FileNotFoundError
+
+    assert joined is not None and joined.is_file()
+    assert nframes(joined) > 2 * nframes(verdict)  # both parts and the pause are in it
+    assert verdict.is_file()  # the reused part is still cached for the next reading
+    left = list(sp.live_dir.glob("*.wav"))
+    assert len(left) == sp.LIVE_KEEP  # and the cache is back at its cap, the oldest fillers having gone
+    assert not (sp.live_dir / f"{0:040x}.wav").exists() and joined in left
+
+
+def test_a_reading_that_fits_leaves_the_cache_alone(tmp_path):
+    tts.set_engine(FakeEngine())
+    sp, _ = speaker(tmp_path)
+    path = sp._audio(["First line.", "Second line."], None)
+    assert path.is_file() and len(list(sp.live_dir.glob("*.wav"))) == 3  # two parts and the joined line
+
+
+def test_say_plays_a_multipart_reading_when_the_cache_is_full(tmp_path, monkeypatch):
+    monkeypatch.setattr(tts.Speaker, "LIVE_KEEP", 3)
+    tts.set_engine(FakeEngine())
+    sp, s = speaker(tmp_path)
+    sp.say(["Correct.", "The first explanation."])
+    assert sp.wait_idle() and sp.player.played
+    time.sleep(0.05)
+    sp.say(["Correct.", "A different explanation."])  # "Correct." is now the oldest cached line, the cap is reached
+    assert sp.wait_idle()
+    time.sleep(0.05)
+    assert len(sp.player.played) == 2 and all(p.is_file() for p in sp.player.played[-1:])
+    sp.close()
+
+
+# ---------------- the words the voice is given (tutor_app.tts.spoken) ----------------
+@pytest.mark.parametrize("raw,words", [
+    ("Neutrons = 131 - 53 = 78", "Neutrons equals one hundred and thirty one minus fifty three equals seventy eight."),
+    ("2CO + 2NO -> 2CO2 + N2", "two C O plus two N O gives two C O two plus N two."),
+    ("2.42 x 24.0 = 58.08", "two point four two times twenty four point zero equals fifty eight point zero eight."),
+    ("the 2- charge means two extra electrons", "the two minus charge means two extra electrons."),
+    ("Option A is correct.", "Option eh is correct."),
+    ("Compare the p.d.s across two equal series resistors.", "Compare the potential differences across two equal series resistors."),
+])
+def test_spoken_gives_the_standard_exam_wording(raw, words):
+    assert tts.spoken(raw) == words
+
+
+def test_a_multipart_feedback_reads_the_table_in_the_stem_and_the_letter_in_the_answer():
+    from tutor_app.screens import spoken_feedback
+    parts = spoken_feedback({"correct": False, "answer": "A: P reinforcement; Q cancellation.", "explanation": "Option A is correct."}, "B")
+    assert [tts.spoken(p) for p in parts] == [
+        "Not quite. The answer is eh, P reinforcement, Q cancellation.", "Option eh is correct."]
+    assert tts.spoken("| t | 1 | 2 |\n|---|---|---|\n| Frequency | 8 | 12 |") == "t, Frequency. one, eight. two, twelve."
