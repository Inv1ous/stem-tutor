+"""Bug-watch batch F: how maths, chemistry and labels are turned into spoken words (tutorlib/speech.py).
+
+Each test pins one finding from the bug watch (B-112 .. B-116, B-126, B-128).  They are quick and need no speech engine."""
+import json
+from pathlib import Path
+
+import pytest
+
+from tutorlib.speech import for_tts, note_paragraphs, script_for_chapter, speakable
+
+BUILD = Path(__file__).resolve().parents[1] / "build" / "out"
+
+
+def say(text: str) -> str:
+    """speakable() without the final full stop."""
+    out = speakable(text)
+    assert out == "" or out[-1] in ".?!", out
+    return out[:-1] if out else out
+
+
+def tts(text: str) -> str:
+    """for_tts() (what the synthesiser is given) without the final full stop."""
+    out = for_tts(text)
+    return out[:-1] if out[-1:] in (".", "?", "!") else out
+
+
+def published_item(spec: str, sub: str, item_id: str) -> dict:
+    path = BUILD / "packs" / spec / f"{sub}.json"
+    if not path.is_file():
+        pytest.skip("no published packs in this checkout")
+    return next(it for it in json.loads(path.read_text(encoding="utf-8"))["items"] if it["id"] == item_id)
+
