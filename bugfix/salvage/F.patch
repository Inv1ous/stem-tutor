+# ---------------- B-128: a table the question needs is read ----------------
+FREQUENCY_STEM = ("The table shows the delivery times, $t$ minutes, for 40 parcels.\n\n"
+                  "| $t$ (min) | $10\\le t<20$ | $20\\le t<25$ | $25\\le t<40$ | $40\\le t<60$ |\n"
+                  "|---|---|---|---|---|\n| Frequency | 8 | 12 | 12 | 8 |\n\n"
+                  "Use linear interpolation to estimate the upper quartile, $Q_3$.")
+
+
+def test_a_frequency_table_is_read_class_by_class_in_place():
+    out = speakable(FREQUENCY_STEM)
+    intro, rest = out.split(" t, min, Frequency. ")
+    assert intro == "The table shows the delivery times, t minutes, for forty parcels."
+    classes = rest.split(" Use linear interpolation")[0].rstrip(".").split(". ")
+    assert classes == [
+        "ten is less than or equal to t is less than twenty, eight",
+        "twenty is less than or equal to t is less than twenty five, twelve",
+        "twenty five is less than or equal to t is less than forty, twelve",
+        "forty is less than or equal to t is less than sixty, eight",
+    ]
+    assert out.endswith("Use linear interpolation to estimate the upper quartile, Q three.")
+
+
