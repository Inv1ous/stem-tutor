+# ---------------- B-112: a spaced minus is subtraction, not a pause ----------------
+@pytest.mark.parametrize("text,words", [
+    ("131 - 53 = 78", "one hundred and thirty one minus fifty three equals seventy eight"),
+    ("16 - 2 = 14", "sixteen minus two equals fourteen"),
+    ("5 + 4 - 1 = 8", "five plus four minus one equals eight"),
+    ("(3 + 4) - 2 = 5", "three plus four, minus two equals five"),  # the brackets are a pause either side
+    ("Neutrons = 60 - 26", "Neutrons equals sixty minus twenty six"),
+    ("0.150 - 0.030 = 0.120 mol", "zero point one five zero minus zero point zero three zero equals zero point one two zero moles"),
+    ("electrons = protons - size of charge", "electrons equals protons minus size of charge"),
+    ("19.2 – 7.2 = 12 m", "nineteen point two minus seven point two equals twelve metres"),  # en dash, inside an equation
+])
+def test_spaced_minus_in_prose_is_said_minus(text, words):
+    assert say(text) == words
+
+
+@pytest.mark.parametrize("text", [
+    "the answer – which is odd – is 3",   # a sentence dash
+    "range 10 – 20 cm",                    # an en-dash range
+    "x - y",                               # no number, no equation: left as it was
+])
+def test_a_sentence_dash_or_range_is_not_turned_into_minus(text):
+    assert "minus" not in say(text)
+
+
+def test_the_published_subtraction_explanation_keeps_its_minus():
+    spoken = for_tts(published_item("9701", "9701-1.1", "9701-1.1-p07")["explanation"])
+    assert "one hundred and thirty one minus fifty three equals seventy eight" in spoken
+    assert "fifty three plus one equals fifty four" in spoken
+
+
+# ---------------- B-113: an arrow typed as characters is a reaction arrow ----------------
+def test_ascii_reaction_arrow_says_gives_not_greater_than():
