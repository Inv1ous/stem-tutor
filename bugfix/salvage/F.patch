+                            ("S1-2-r03", ["twenty", "thirty", "thirty five", "fifteen"])]:
+        spoken = for_tts(published_item("S1", "S1-2", item_id)["stem"])
+        assert "less than or equal to t is less than" in spoken, item_id
+        for count in counts:
+            assert f", {count}." in spoken, (item_id, count)
+
