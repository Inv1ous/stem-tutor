+@needs_node
+def test_the_page_drops_a_tick_from_the_tutors_the_moment_it_is_taken_away(tmp_path):
+    """B-047: not only when the tutor next writes (it may not for days): at each pull, and at once on a redraw."""
+    tutors = {"stamp": "s1", "done": {"5-phys1": 1}, "seen": {}}  # what the page holds after the tutor's update
+    S, calls = run_page(tmp_path, blank(tutor=tutors), {"stamp": "s1", "done": {"5-phys1": 1}})  # taken away since
+    assert S["done"] == {} and S["tutor"]["done"] == {} and S["tutor"]["seen"] == {"5-phys1": 1}
+    assert calls[0] == "save"  # kept straight away
+    S, calls = run_page(tmp_path, blank(done={"5-phys1": 1}, tutor=tutors), {"stamp": "s1"})  # nobody touched it
+    assert S["tutor"]["done"] == {"5-phys1": 1} and "save" not in calls
+    # taken away, then ticked again before the next pull: the redraw in between is what tells them apart
+    S, calls = run_page(tmp_path, blank(done={"5-phys1": 1}, tutor=tutors), {"stamp": "s1"}, observer=True)
+    assert S["done"] == {"5-phys1": 1} and S["tutor"]["done"] == {} and S["tutor"]["seen"] == {"5-phys1": 1}
+    assert calls.count("save") == 1
