+@pytest.mark.skipif(almanac._in_temp(OUTSIDE), reason="the repo itself is in the temporary folder")
+def test_a_scratch_vault_never_writes_a_sync_file_beside_a_planner_outside_it(tutor, monkeypatch):
+    written = []
+    monkeypatch.setattr(report, "_write_text", lambda path, text: written.append(str(path)))
+    tutor.packs.plan["source_path"] = str(OUTSIDE)  # what every published plan carries: the learner's own planner
+    assert almanac.sync_file(tutor.packs.plan, tutor.vault.root) is None
+    assert report.almanac_push(tutor) is None
+    tutor.start("learn", minutes=20, focus=["9702-2.1.1"])  # a session start syncs the Almanac; so does each answer
+    tutor._sync_almanac(force=True)
+    assert written == []
+    # the learner's real vault (not in the temporary folder) does write beside its planner
+    real = OUTSIDE.parent / "STEM Tutor"
+    assert almanac.sync_file(tutor.packs.plan, real) == OUTSIDE.with_suffix(".tutor.js")
+
