+# ---------- B-089: practice reaches every subtopic ----------
+def ans(kc, ts, subject="chem"):
+    return {"type": "answer", "ts": ts.isoformat(), "item": f"{kc}-i1", "kcs": [kc], "subject": subject,
+            "difficulty": 3, "conf": 3, "hinted": False, "seconds": None, "marks": 1,
+            "grade": {"correct": False, "score": 0.0, "error": None, "misconception": None}, "credit": [], "pos": 0}
+
+
+def weak_ideas(tutor, subtopics, per=2, when=T0):
+    """Ideas of `subtopics`, each answered wrong at `when`; returns their ids."""
+    kcs = []
+    for s in subtopics:
+        for j in range(1, per + 1):
+            kc = f"9701-{s}.1.{j}"
+            tutor.packs.kcs[kc] = {"id": kc, "subtopic": f"9701-{s}.1", "spec": "9701", "subject": "chem", "level": "AS",
+                                   "title": kc, "type": "conceptual", "prereqs": []}
+            model.apply(tutor.state, ans(kc, when + timedelta(seconds=len(kcs))))
+            kcs.append(kc)
+    tutor.packs.items_for = lambda kc: [{"id": kc}]
+    return kcs
+
+
+def practice_of(tutor, now=T0 + timedelta(minutes=1), minutes=30):
+    blocks = policy.plan_session(tutor.state, tutor.packs, now, minutes, "repair")
+    return next(b["kcs"] for b in blocks if b["kind"] == "practice")
+
+
+def subtopic_of(tutor, kcs):
+    return [tutor.packs.kc(k)["subtopic"] for k in kcs]
+
+
+def test_practice_takes_one_idea_from_each_subtopic_before_a_second_from_any(tutor):
+    """B-089: ten slots used to go to the first few subtopics, several ideas each."""
+    weak_ideas(tutor, range(1, 21), per=3)
+    subs = subtopic_of(tutor, practice_of(tutor))
+    assert len(subs) == 10 and len(set(subs)) == 10
+
+
+def test_practice_goes_to_the_ideas_most_at_risk_not_the_earliest_chapters(tutor):
+    """The ideas not seen for weeks have the lowest chance of being recalled: they come first, wherever they sit."""
+    stale = weak_ideas(tutor, range(11, 21), when=T0 - timedelta(days=30))
+    weak_ideas(tutor, range(1, 11), when=T0 - timedelta(minutes=5))  # early chapters, answered just now
+    chosen = practice_of(tutor)
+    assert len(chosen) == 10 and set(chosen) <= set(stale)
+
+
+def test_practising_an_idea_lets_the_others_in_next_time(tutor):
+    kcs = weak_ideas(tutor, range(1, 21), per=1)
+    first = practice_of(tutor)
+    tomorrow = T0 + timedelta(days=1)
+    for i, kc in enumerate(first):  # they are practised the next day (the first answer of a day is what reschedules)
+        model.apply(tutor.state, ans(kc, tomorrow + timedelta(seconds=i)))
+    again = practice_of(tutor, tomorrow + timedelta(minutes=5))
+    assert len(again) == 10 and not set(again) & set(first) and set(first + again) == set(kcs)
+
