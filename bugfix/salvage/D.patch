+global.requestAnimationFrame = fn => fn();
+if ({json.dumps(observer)}) global.MutationObserver = class {{ constructor(fn) {{ global.mutated = fn; }} observe() {{}} }};
+global.document = {{ getElementById: () => null, body: {{}}, activeElement: {{ tagName: "BODY" }}, createElement: () => ({{ remove() {{}} }}),
+  head: {{ appendChild(el) {{ vm.runInThisContext(fs.readFileSync({json.dumps(str(tmp_path))} + "/" + el.src.split("?")[0], "utf8")); el.onload(); }} }} }};
+"""
+    tail = ('\ndelete S.done["5-phys1"]; mutated(); S.done["5-phys1"] = 1; mutated();\n' if observer else "") \
+        + "\nconsole.log(JSON.stringify([S, calls]));"
+    out = subprocess.run(["node", "-e", head + block + tail], capture_output=True, text=True, check=True).stdout
+    return json.loads(out)
+
