+"""Bug-watch batch D: the Almanac sync (B-044 B-047 B-064 B-069 B-085), auto-ticks (B-041), which ideas practice picks
+(B-089) and a scratch vault never writing outside itself (B-062)."""
+import json
+import os
+import random
+import shutil
+import subprocess
+import sys
+import tempfile
+from datetime import datetime, timedelta
+from pathlib import Path
+
+import pytest
+
+from fixtures import make_vault
+from tutorlib import almanac, model, policy, report, session, store
+
+REPO = Path(__file__).resolve().parents[1]
+JS = (REPO / "build/almanac_link.js").read_text()
+T0 = datetime.fromisoformat("2026-09-29T17:00:00+08:00")  # Almanac week 5
+needs_node = pytest.mark.skipif(not shutil.which("node"), reason="needs Node to run the page's script")
+
+
+class Clock:
+    def __init__(self, t):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+def make_tutor(tmp_path, plan_extra=None):
+    """A tutor over the small test vault; `plan_extra` goes into its published plan before it opens."""
+    root = make_vault(tmp_path)
+    if plan_extra:
+        plan_file = next((root / ".tutor/packs").glob("v*/plan.json"))
+        plan_file.write_text(json.dumps({**json.loads(plan_file.read_text()), **plan_extra}))
+    return session.Tutor(store.Vault(root), rng=random.Random(0), now=Clock(T0))
+
+
+@pytest.fixture
+def tutor(tmp_path):
+    return make_tutor(tmp_path)
+
+
+def export(root, state, when=None):
+    """The progress file the Almanac's Export button leaves in the vault's Almanac folder."""
+    folder = Path(root) / "Almanac"
+    folder.mkdir(parents=True, exist_ok=True)
+    path = folder / f"almanac-progress-{len(list(folder.iterdir())) + 1}.json"
+    path.write_text(json.dumps(state))
+    stamp = (when or datetime.now()).timestamp()
+    os.utime(path, (stamp, stamp))
+    return path
+
+
+def ticks_of(root, state):
+    """What the tutor reads as the learner's own ticks from an export of that planner state."""
+    export(root, state)
+    return almanac.ticks(root)
+
+
+def page(code):
+    """Run the page's sync script in Node, then `code`, which prints one JSON value."""
+    out = subprocess.run(["node", "-e", JS + "\n" + code], capture_output=True, text=True, check=True).stdout
+    return json.loads(out)
+
+
+def merged(state, *updates):
+    """The planner state after the tutor's updates are merged into it one after another."""
+    return page(f"const S = {json.dumps(state)}; for (const T of {json.dumps(updates)}) tutorMerge(S, T);"
+                "\nconsole.log(JSON.stringify(S));")
+
+
+def blank(**extra):
+    return {"done": {}, "rag": {}, "scores": {}, "wall": {}, "retro": {}, "err": {}, **extra}
+
+
+# ---------- B-044 and B-047: whose tick is it ----------
+@needs_node
+def test_a_tick_the_learner_made_first_stays_off_once_they_take_it_away():
+    """B-044: the tutor earned an objective the learner had ticked already; unticked, a later update ticked it again."""
+    S = merged(blank(done={"5-phys1": 1}), {"stamp": "a", "done": {"5-phys1": 1}})
+    assert S["done"] == {"5-phys1": 1} and S["tutor"]["done"] == {}  # their own tick: not recorded as the tutor's
+    del S["done"]["5-phys1"]  # the learner takes it away
+    S = merged(S, {"stamp": "b", "done": {"5-phys1": 1}}, {"stamp": "c", "done": {"5-phys1": 1}})
+    assert S["done"] == {}  # and it stays away
+
+
+@needs_node
+def test_a_tick_the_learner_takes_away_and_gives_back_is_theirs_again(tmp_path):
+    """B-047: after the learner's own tick, the engine must see the claim even though the tutor once earned it."""
+    S = merged(blank(), {"stamp": "a", "done": {"5-phys1": 1}})
+    assert S["done"] == {"5-phys1": 1} and S["tutor"]["done"] == {"5-phys1": 1}
+    assert ticks_of(tmp_path / "tutors", S) == frozenset()  # the tutor's own tick: not a claim
+    del S["done"]["5-phys1"]
+    S = merged(S, {"stamp": "b", "done": {"5-phys1": 1}})  # the page notices the tick is off
+    assert S["done"] == {} and S["tutor"]["done"] == {}
+    S["done"]["5-phys1"] = 1  # the learner ticks it again
+    S = merged(S, {"stamp": "c", "done": {"5-phys1": 1}})
+    assert S["done"] == {"5-phys1": 1} and S["tutor"]["done"] == {}  # still theirs after the next update
+    assert ticks_of(tmp_path / "theirs", S) == {"5-phys1"}  # and the tutor counts it
+    # a tutor tick that no longer holds up is not turned into the learner's claim by someone leaving it alone
+    S = merged(blank(), {"stamp": "a", "done": {"5-phys1": 1}}, {"stamp": "b", "done": {}})
+    assert ticks_of(tmp_path / "left", S) == frozenset()
+
+
+def run_page(tmp_path, state, payload, observer=False):
+    """The whole block as the page runs it, from a planner state already holding the tutor's earlier update. With
+    `observer`, the page redraws (the stand-in for its MutationObserver fires) as the learner unticks and re-ticks."""
+    (tmp_path / "A-Levels.tutor.js").write_text("window.TUTOR_SYNC = " + json.dumps(payload) + ";\n")
+    block = JS.replace("__FILE__", "A-Levels.tutor.js")
+    head = f"""
+const fs = require("fs"), vm = require("vm"), calls = [];
+global.window = global;
+global.S = {json.dumps(state)};
